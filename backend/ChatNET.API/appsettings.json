{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "Url": "http://localhost:5173"
  },
  "Jwt": {
    "Issuer": "chatnet-api",
    "Audience": "chatnet-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "RefreshReuseGraceSeconds": 30
  },
  "Storage": {
    "Region": "auto",
    "MaxFileBytes": 10485760,
    "MaxFilesPerMessage": 4,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp",
      "video/mp4",
      "video/webm",
      "application/pdf",
      "text/plain",
      "application/zip"
    ],
    "UploadUrlMinutes": 10,
    "DownloadUrlMinutes": 60
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Refresh": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    }
  }
}
