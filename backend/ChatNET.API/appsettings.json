{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "Url": "http://localhost:5173"
  },
  "Jwt": {
    "Issuer": "chatnet-api",
    "Audience": "chatnet-client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "RefreshReuseGraceSeconds": 30
  },
  "Push": {
    "AllowedHosts": [
      "fcm.googleapis.com",
      "updates.push.services.mozilla.com",
      "push.apple.com",
      "notify.windows.com"
    ]
  },
  "Storage": {
    "Region": "auto",
    "MaxFileBytes": 10485760,
    "MaxFilesPerMessage": 4,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/webp",
      "video/mp4",
      "video/webm",
      "application/pdf",
      "text/plain",
      "application/zip"
    ],
    "UploadUrlMinutes": 10,
    "DownloadUrlMinutes": 60
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    },
    "Refresh": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "Send": {
      "PermitLimit": 30,
      "WindowSeconds": 10
    },
    "Uploads": {
      "PermitLimit": 60,
      "WindowSeconds": 3600
    },
    "Edit": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Avatars": {
      "PermitLimit": 600,
      "WindowSeconds": 60
    },
    "Push": {
      "PermitLimit": 20,
      "WindowSeconds": 60
    },
    "Keys": {
      "PermitLimit": 60,
      "WindowSeconds": 60
    },
    "ForgotPassword": {
      "PermitLimit": 5,
      "WindowSeconds": 900
    },
    "ResetPassword": {
      "PermitLimit": 10,
      "WindowSeconds": 900
    },
    "PasswordResetEmail": {
      "PermitLimit": 3,
      "WindowSeconds": 3600
    },
    "Store": {
      "KeyPrefix": "ratelimit",
      "TimeoutMilliseconds": 200,
      "PauseSeconds": 5
    }
  }
}
