{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Frontend": {
    "Url": "http://localhost:5173"
  },
  "Jwt": {
    "Issuer": "chatnet-api",
    "Audience": "chatnet-client",
    "ExpiryDays": 7
  },
  "RateLimiting": {
    "Auth": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  }
}
