# Copy this file to .env and fill in real values.
# .env is gitignored; never commit it.

POSTGRES_DB=chatnet
POSTGRES_USER=chatnet_user
POSTGRES_PASSWORD=change_me_use_a_strong_password

# Object storage for attachments. RustFS runs locally and answers the S3 API on http://localhost:9000;
# production uses Cloudflare R2 instead. Use the same two values for the API:
#   dotnet user-secrets set "Storage:AccessKey" "<RUSTFS_ACCESS_KEY>"
#   dotnet user-secrets set "Storage:SecretKey" "<RUSTFS_SECRET_KEY>"
RUSTFS_ACCESS_KEY=change_me_access_key
RUSTFS_SECRET_KEY=change_me_use_a_strong_secret_key
STORAGE_BUCKET=chatnet
