# Copy this file to .env and fill in real values.
# .env is gitignored; never commit it.

POSTGRES_DB=chatnet
POSTGRES_USER=chatnet_user
POSTGRES_PASSWORD=change_me_use_a_strong_password

# Object storage for attachments. RustFS runs locally and answers the S3 API on http://localhost:9000;
# any S3-compatible store (Cloudflare R2 is the one this was written for) works in its place. Use the same two values for the API:
#   dotnet user-secrets set "Storage:AccessKey" "<RUSTFS_ACCESS_KEY>"
#   dotnet user-secrets set "Storage:SecretKey" "<RUSTFS_SECRET_KEY>"
RUSTFS_ACCESS_KEY=change_me_access_key
RUSTFS_SECRET_KEY=change_me_use_a_strong_secret_key
STORAGE_BUCKET=chatnet

# The TURN server (coturn) that relays a call when two browsers cannot reach each other. The API makes short-lived credentials from this
# secret, so give the API the same value, and the addresses it hands out (not secret, and not in a tracked file; at least 32 characters):
#   dotnet user-secrets set "Turn:Secret" "<TURN_SECRET>"
#   dotnet user-secrets set "Turn:Urls:0" "turn:localhost:3478?transport=udp"
#   dotnet user-secrets set "Turn:Urls:1" "turn:localhost:3478?transport=tcp"
#   dotnet user-secrets set "Turn:StunUrls:0" "stun:localhost:3478"
# Make it with:  openssl rand -hex 32
TURN_SECRET=change_me_openssl_rand_hex_32
