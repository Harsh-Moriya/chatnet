# Prefix with VITE_ to expose to the browser bundle.
# Leave both blank in development: Vite proxies /api and /hubs to the backend automatically.
# In production, set them to the backend's URLs if it is served from another origin.

# Base URL of the REST API, for example https://api.chatnet.app/api (default: /api)
VITE_API_URL=

# URL of the SignalR hub, for example https://api.chatnet.app/hubs/chat (default: /hubs/chat)
VITE_HUB_URL=
