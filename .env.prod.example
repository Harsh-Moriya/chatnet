# Copy this file to .env.prod and fill in real values. .env.prod is gitignored; never commit it.
# Use it with:  docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Generate each secret with:  openssl rand -hex 32
# Use hex (or another plain alphanumeric string) for the passwords: they are placed in connection strings, where
# a semicolon or an equals sign would end the value.

# ##### The site #####
# The host name people will type. Its DNS A (and AAAA) record must point at this machine, and ports 80 and 443 must be
# open, before the first start: Caddy asks the certificate authority for a certificate as soon as it runs.
DOMAIN=chat.example.com

# Optional. Leave unset to serve https://DOMAIN. Set it to http://localhost, with DOMAIN=localhost, to try the stack
# on one machine without TLS.
# SITE_ADDRESS=

# ##### Database #####
POSTGRES_DB=chatnet
POSTGRES_USER=chatnet_user
POSTGRES_PASSWORD=change_me_openssl_rand_hex_32

# ##### Redis #####
REDIS_PASSWORD=change_me_openssl_rand_hex_32

# ##### Tokens #####
# The key access tokens are signed with: at least 32 bytes. Changing it signs everybody out.
JWT_SIGNING_KEY=change_me_openssl_rand_hex_32

# ##### Object storage (Cloudflare R2, or any S3-compatible service) #####
# Browsers upload to and download from this address directly, so it must be reachable from them over https.
# R2: https://<account id>.r2.cloudflarestorage.com. The bucket needs the CORS rules and the lifecycle rule in note 19.
STORAGE_SERVICE_URL=https://change_me.r2.cloudflarestorage.com
STORAGE_BUCKET=chatnet
STORAGE_ACCESS_KEY=change_me
STORAGE_SECRET_KEY=change_me

# ##### Optional #####
# The host names the API answers to, separated by semicolons. The default is DOMAIN and localhost (the container's own
# health check asks for localhost). Set it only to add a second name.
# ALLOWED_HOSTS=chat.example.com;www.chat.example.com;localhost
# Send the API's traces to Jaeger (start the stack with --profile tracing). Leave unset to export nothing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317
# How many API instances run. They share the work and find each other through Redis.
# API_REPLICAS=2
# The network Caddy reaches the API from. Its word about the client's address is believed, nobody else's. Docker's
# private ranges all fall inside the default; only change it if you moved this stack's network outside them.
# TRUSTED_PROXY_NETWORK=172.16.0.0/12
# Tags the images this stack builds, so an older one can be started again.
# CHATNET_VERSION=local
